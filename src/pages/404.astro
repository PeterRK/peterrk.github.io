---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到" description="请求的页面不存在。" canonicalPath="/404.html">
  <section class="not-found">
    <p class="error-code">404</p>
    <h1>这里没有留下记录。</h1>
    <p>页面可能被移动，或者从未存在过。</p>
    <a class="button-link" href="/">返回首页</a>
  </section>
</BaseLayout>
