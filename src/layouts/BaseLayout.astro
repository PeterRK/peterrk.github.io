---
import '../styles/global.css';
import { licenses } from '../data/licenses';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  wide?: boolean;
}

const {
  title = 'RK 的备忘录',
  description = '记录一些值得留下的东西。',
  canonicalPath = Astro.url.pathname,
  wide = false,
} = Astro.props;

const pageTitle = title === 'RK 的备忘录' ? title : `${title} · RK 的备忘录`;
const canonicalURL = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17211f" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <div class="site-shell">
      <aside class="site-rail">
        <div class="rail-inner">
          <a class="brand" href="/" aria-label="RK 的备忘录首页">
            <span class="brand-mark" aria-hidden="true">RK</span>
            <span class="brand-copy">
              <strong>RK 的备忘录</strong>
              <small>Notes & archives</small>
            </span>
          </a>

          <nav class="site-nav" aria-label="译文列表">
            <p class="nav-label">译文</p>
            <ol>
              {licenses.map((license) => (
                <li>
                  <a
                    href={license.path}
                    aria-current={Astro.url.pathname === license.path ? 'page' : undefined}
                  >
                    {license.title}
                  </a>
                </li>
              ))}
            </ol>
          </nav>

          <p class="rail-footer">GNU GPL · 非官方中文翻译</p>
        </div>
      </aside>

      <main id="content" class:list={['site-main', { 'site-main--wide': wide }]}>
        <slot />
      </main>
    </div>
  </body>
</html>
